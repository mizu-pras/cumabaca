{
  "info": {
    "name": "Cuma Baca API",
    "description": "A minimalist comic scraper API that fetches content from multiple comic websites and provides a clean, distraction-free reading experience with admin management capabilities.",
    "version": "1.0.0",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3100",
      "type": "string"
    },
    {
      "key": "admin_token",
      "value": "",
      "type": "string",
      "disabled": true
    }
  ],
  "auth": {
    "type": "apikey",
    "apikey": [
      {
        "key": "in",
        "value": "cookie",
        "type": "string"
      },
      {
        "key": "value",
        "value": "admin_token={{admin_token}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "execution/javascript",
        "exec": [
          "// Auto-include cookie header for admin requests",
          "const url = request.url.toLowerCase();",
          "if (url.includes('/admin/')) {",
          "    const token = pm.environment.get('admin_token');",
          "    if (token) {",
          "        pm.request.headers.add({",
          "            key: 'Cookie',",
          "            value: 'admin_token=' + token",
          "        });",
          "    }",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Comic Scraping",
      "description": "Public endpoints for scraping comic content",
      "item": [
        {
          "name": "Get Chapter List",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/komik/chapters?url=https://komiku.org/manga/one-piece",
              "host": ["{{baseUrl}}"],
              "path": ["komik", "chapters"],
              "query": [
                {
                  "key": "url",
                  "value": "https://komiku.org/manga/one-piece",
                  "description": "URL of the comic page to scrape"
                },
                {
                  "key": "mode",
                  "value": "normal",
                  "description": "Content mode (required for NSFW sources: normal/secret)",
                  "disabled": true
                }
              ]
            },
            "description": "Scrapes and returns the chapter list for a comic from the specified URL.\n\n**Note**: First request may take 5-10 seconds. Subsequent requests are cached (24h TTL)."
          }
        },
        {
          "name": "Get Chapter Data (Images)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/komik/data?url=https://komiku.org/manga/one-piece/chapter-1",
              "host": ["{{baseUrl}}"],
              "path": ["komik", "data"],
              "query": [
                {
                  "key": "url",
                  "value": "https://komiku.org/manga/one-piece/chapter-1",
                  "description": "URL of the chapter page to scrape"
                },
                {
                  "key": "mode",
                  "value": "normal",
                  "description": "Content mode (required for NSFW sources: normal/secret)",
                  "disabled": true
                }
              ]
            },
            "description": "Scrapes and returns the images for a specific chapter.\n\n**Note**: First request may take 5-10 seconds. Subsequent requests are cached (24h TTL)."
          }
        },
        {
          "name": "Proxy Image",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/komik/image?url=https://v1.komikcast.fit/wp-content/uploads/2023/01/001.jpg",
              "host": ["{{baseUrl}}"],
              "path": ["komik", "image"],
              "query": [
                {
                  "key": "url",
                  "value": "https://v1.komikcast.fit/wp-content/uploads/2023/01/001.jpg",
                  "description": "URL of the image to proxy"
                }
              ]
            },
            "description": "Proxies image requests to bypass CORS and hotlink protection.\n\nSome sources (e.g., Komikcast) require this proxy to display images properly.\nSets appropriate CORS headers for cross-origin requests.",
            "response": []
          }
        },
        {
          "name": "Get Cache Statistics",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/komik/cache/stats",
              "host": ["{{baseUrl}}"],
              "path": ["komik", "cache", "stats"]
            },
            "description": "Returns cache statistics including total entries, expired entries, total size, and average size.\n\nUseful for monitoring cache health and usage."
          }
        },
        {
          "name": "Get Cached Comics",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/komik/cached-comics",
              "host": ["{{baseUrl}}"],
              "path": ["komik", "cached-comics"]
            },
            "description": "Retrieves all cached comic data from MongoDB.\n\nReturns a list of previously scraped comic URLs with their metadata and timestamps."
          }
        },
        {
          "name": "Clear Cache Entry",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/komik/cache?key=__express__/komik/chapters?url=https://komiku.org/manga/one-piece",
              "host": ["{{baseUrl}}"],
              "path": ["komik", "cache"],
              "query": [
                {
                  "key": "key",
                  "value": "__express__/komik/chapters?url=https://komiku.org/manga/one-piece",
                  "description": "Cache key to delete"
                }
              ]
            },
            "description": "Deletes a specific cache entry by its key.\n\nUseful for forcing a refresh of specific cached content.\n\nTo clear all cache, use the 'Clear All Cache' request."
          }
        }
      ]
    },
    {
      "name": "Admin Auth",
      "description": "Admin authentication endpoints",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"securepassword123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/admin/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "auth", "login"]
            },
            "description": "Authenticates an admin user and sets a JWT cookie.\n\nOn successful login, an httpOnly cookie `admin_token` is set with a 24-hour expiry.\n\n**Default credentials** (change in production):\n- Username: `admin`\n- Password: `securepassword123`"
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "execution/javascript",
                "exec": [
                  "// Save token from response cookies",
                  "const cookies = pm.response.headers.all().filter(h => h.key.toLowerCase() === 'set-cookie');",
                  "if (cookies.length > 0) {",
                  "    const cookieHeader = cookies[0].value;",
                  "    const tokenMatch = cookieHeader.match(/admin_token=([^;]+)/);",
                  "    if (tokenMatch) {",
                  "        pm.environment.set('admin_token', tokenMatch[1]);",
                  "        console.log('Token saved to environment');",
                  "    }",
                  "}",
                  "",
                  "// Also check for token in response body",
                  "try {",
                  "    const json = pm.response.json();",
                  "    if (json.token) {",
                  "        pm.environment.set('admin_token', json.token);",
                  "    }",
                  "} catch (e) {",
                  "    // No JSON response",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/admin/auth/logout",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "auth", "logout"]
            },
            "description": "Clears the authentication cookie.\n\nUse this to securely end the admin session."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "execution/javascript",
                "exec": [
                  "// Clear token from environment",
                  "pm.environment.set('admin_token', '');",
                  "console.log('Token cleared from environment');"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Current User",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/admin/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "auth", "me"]
            },
            "description": "Returns the currently authenticated admin user from the JWT cookie.\n\nRequires valid `admin_token` cookie (set via Login).\n\nUse this to verify authentication status."
          }
        }
      ]
    },

{
    "name": "cumabaca-monorepo",
    "version": "0.0.0",
    "private": true,
    "description": "Cuma Baca - A minimalist comic scraper with monorepo architecture",
    "workspaces": [
        "backend",
        "frontend"
    ],
    "scripts": {
        "dev": "concurrently \"pnpm run dev:backend\" \"pnpm run dev:frontend\"",
        "dev:backend": "podman-compose -f docker-compose.dev.yml up",
        "dev:frontend": "pnpm --filter cumabaca-frontend dev",
        "dev:admin": "pnpm --filter cumabaca-admin dev",
        "build": "pnpm --filter cumabaca-frontend build",
        "build:admin": "pnpm --filter cumabaca-admin build"
    },
    "devDependencies": {
        "concurrently": "^9.2.1"
    },
    "engines": {
        "node": ">=18.0.0",
        "npm": ">=9.0.0"
    }
}

{
    "name": "cumabaca-monorepo",
    "version": "0.0.0",
    "private": true,
    "description": "Cuma Baca - A minimalist comic scraper with monorepo architecture",
    "workspaces": [
        "backend",
        "frontend"
    ],
    "scripts": {
        "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
        "dev:backend": "docker-compose -f docker-compose.dev.yml up",
        "dev:frontend": "cd frontend && vite",
        "build": "cd frontend && vite build"
    },
    "devDependencies": {
        "concurrently": "^9.2.1"
    },
    "engines": {
        "node": ">=18.0.0",
        "npm": ">=9.0.0"
    }
}

{
    "name": "cumabaca-monorepo",
    "version": "0.0.0",
    "private": true,
    "description": "Cuma Baca - A minimalist comic scraper with monorepo architecture",
    "workspaces": [
        "backend",
        "frontend",
        "admin",
        "scraper"
    ],
    "scripts": {
        "dev": "concurrently \"pnpm:dev:scraper\" \"pnpm:dev:backend\" \"pnpm:dev:frontend\" \"pnpm:dev:admin\"",
        "dev:backend": "podman-compose -f docker-compose.dev.yml up",
        "dev:frontend": "pnpm --filter cumabaca-frontend dev",
        "dev:admin": "pnpm --filter cumabaca-admin dev",
        "dev:scraper": "pnpm --filter @cumabaca/scraper dev",
        "dev:all": "concurrently \"pnpm:dev:scraper\" \"pnpm:dev:backend\" \"pnpm:dev:frontend\" \"pnpm:dev:admin\"",
        "build": "pnpm --filter \"./backend/**\" --filter \"./frontend/**\" --filter \"./admin/**\" --filter \"./scraper/**\" build"
    },
    "devDependencies": {
        "concurrently": "^9.2.1"
    },
    "engines": {
        "node": ">=18.0.0",
        "npm": ">=9.0.0"
    }
}
